---
import { Image } from "astro:assets";
import ESI_Logo_fin_white from "../../assets/ESI_Logo_fin_white.png";

/** MailerLite embedded form (ID 47822263, account 2742698). */
const NEWSLETTER_ENDPOINT =
  "https://assets.mailerlite.com/jsonp/2742698/forms/202747197716956497/subscribe";
const NEWSLETTER_TRACK_URL =
  "https://assets.mailerlite.com/jsonp/2742698/forms/202747197716956497/takel";

const exploreLinks: [string, string][] = [
  ["About us", "/about-us"],
  ["Mission", "/mission"],
  ["Our work", "/projects"],
  ["Council & Experts", "/council-experts"],
  ["Partnerships", "/partnership"],
  ["Membership", "/member"],
];

// Press room and Careers have no pages yet — link as "#" until those are built.
const resourceLinks: [string, string][] = [
  ["Publications", "/projects"],
  ["Events", "/projects"],
  ["Press room", "#"],
  ["Careers", "#"],
];

// Cookies and Accessibility have no pages yet — link as "#" until those are built.
const legalLinks: [string, string][] = [
  ["Privacy", "/privacy"],
  ["Legal & Governance", "/legal"],
  ["Cookies", "#"],
  ["Accessibility", "#"],
];
---

<footer class="global-footer">
  <div class="footer-hero">
    <div class="footer-locations-block">
      <div class="footer-logo-row">
        <Image
          class="footer-logo"
          src={ESI_Logo_fin_white}
          alt="The European Strategy Institute"
        />
        <p class="footer-tagline">
          Empowering European Business
          <br />
          Navigating for a better future.
        </p>
      </div>
      <p class="footer-locations">
        <span class="footer-locations-rule" aria-hidden="true"></span>
        Brussels &ndash; Warsaw
        <span class="footer-locations-rule" aria-hidden="true"></span>
      </p>
    </div>
    <div class="footer-newsletter-block">
      <div id="mlb2-47822263" class="ml-subscribe-form ml-subscribe-form-47822263">
        <div class="row-form">
          <p class="footer-newsletter-heading">
            Sign up for our NEWSLETTER and stay informed.
          </p>
          <form
            class="footer-newsletter ml-block-form"
            method="post"
            action={NEWSLETTER_ENDPOINT}
            data-code=""
            target="_blank"
          >
            <div class="footer-newsletter-row">
              <div
                class="ml-field-group ml-field-email ml-validate-email ml-validate-required"
              >
                <input
                  type="email"
                  name="fields[email]"
                  required
                  autocomplete="email"
                  placeholder="Your email address"
                  aria-label="Your email address"
                />
              </div>
              <button type="submit" class="primary" aria-label="Subscribe">
                <span class="footer-newsletter-label" aria-hidden="true">
                  Subscribe
                </span>
                <span aria-hidden="true">→</span>
              </button>
              <button
                type="button"
                class="loading"
                disabled
                style="display: none;"
              >
                <span class="ml-form-embedSubmitLoad"></span>
                <span class="sr-only">Loading...</span>
              </button>
            </div>
            <div class="ml-form-checkboxRow ml-validate-required">
              <label class="footer-newsletter-consent checkbox">
                <input type="checkbox" name="consent" required />
                <span class="label-description">
                  I agree to receive updates from The European Strategy
                  Institute. You can unsubscribe at any time.
                </span>
              </label>
            </div>
            <input type="hidden" name="ml-submit" value="1" />
            <input type="hidden" name="anticsrf" value="true" />
          </form>
        </div>
        <div class="row-success" style="display: none;">
          <p class="footer-newsletter-heading">Thank you!</p>
          <p class="footer-newsletter-success">
            You have successfully joined our subscriber list.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-columns">
    <div class="footer-brand">
      <p class="footer-description">
        A Brussels-based independent think tank and strategic dialogue platform
        working at the intersection of business, policy and European
        institutions.
      </p>
      <p class="footer-enterprise">Enterprise Number (BCE/KBO): 0XXX.XXX.XXX</p>
    </div>

    <nav class="footer-col" aria-label="Explore">
      <h3 class="footer-col-heading">Explore</h3>
      <ul>
        {exploreLinks.map(([label, href]) => (
          <li>
            <a href={href}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Resources">
      <h3 class="footer-col-heading">Resources</h3>
      <ul>
        {resourceLinks.map(([label, href]) => (
          <li>
            <a href={href}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="footer-col footer-contact-col">
      <h3 class="footer-col-heading">Contact us</h3>
      <address>
        Rue d'Arlon 25, 
        <br />
        1050 Brussels
        <br />
        Belgium
      </address>
      <a class="footer-contact-email" href="mailto:info@esi.eu">
        info@esi.eu
      </a>
    </div>

    <div class="footer-col footer-follow-col">
      <h3 class="footer-col-heading">Follow us</h3>
      <div class="footer-social">
        <a
          href="https://www.instagram.com/theeuropeanstrategyinstitute?stkn=MWU5c3YwNThodzMyNA=="
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
        >
          <svg viewBox="0 0 24 24" width="25" height="25" aria-hidden="true">
            <rect
              x="3"
              y="3"
              width="18"
              height="18"
              rx="5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
            ></rect>
            <circle
              cx="12"
              cy="12"
              r="4.2"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
            ></circle>
            <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor"></circle>
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/company/the-european-strategy-institute/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <svg viewBox="0 0 24 24" width="25" height="25" aria-hidden="true">
            <path
              fill="currentColor"
              d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56z"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="footer-base">
    <span>
      © 2026 The European Strategy Institute (ASBL). All rights reserved.
    </span>
    <div class="footer-base-right">
      {legalLinks.map(([label, href]) => (
        <a href={href}>{label}</a>
      ))}
      <span class="footer-lang">
        EN
        <svg viewBox="0 0 12 8" width="10" height="7" aria-hidden="true">
          <path
            d="M1 1.5 6 6.5 11 1.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </span>
    </div>
  </div>
</footer>

<script is:inline>
  function ml_webform_success_47822263() {
    var $ = window.ml_jQuery || window.jQuery;
    $(".ml-subscribe-form-47822263 .row-success").show();
    $(".ml-subscribe-form-47822263 .row-form").hide();
  }
</script>
<script
  is:inline
  src="https://groot.mailerlite.com/js/w/webforms.min.js?v83147fa8ce2d95cb73ece7f28b469519"
></script>
<script is:inline define:vars={{ NEWSLETTER_TRACK_URL }}>
  fetch(NEWSLETTER_TRACK_URL).catch(function () {});
</script>
