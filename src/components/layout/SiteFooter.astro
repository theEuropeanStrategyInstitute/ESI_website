---
import { Image } from "astro:assets";
import ESI_Logo_fin_white_v3 from "../../assets/ESI_Logo_fin_white_v3.png";

/** Placeholder subscribe endpoint — swap for the real ESP embed URL once chosen. */
const NEWSLETTER_ENDPOINT = "https://newsletter.esi-eu.com/subscribe";

const links: [string, string][] = [
  ["About us", "/about-us"],
  ["Mission", "/mission"],
  ["Programmes & insights", "/projects"],
  ["Partnerships", "/partnership"],
  ["Membership", "/member"],
  ["Contact", "/contact"],
  ["Privacy", "/privacy"],
  ["Legal & Governance", "/legal"],
];
---

<footer class="global-footer">
  <div class="footer-top">
    <Image
      class="footer-logo"
      src={ESI_Logo_fin_white_v3}
      alt="The European Strategy Institute"
    />
    <div class="footer-intro">
      <p>The European Strategy Institute ASBL</p>
      <p>
        An independent Brussels-based think tank connecting Central and Eastern
        European business with European policymaking.
      </p>
    </div>
  </div>
  <div class="footer-lead">
    <dl class="footer-details">
      <div>
        <dt>Email</dt>
        <dd>
          <a href="mailto:partnerships@esi-eu.com">partnerships@esi-eu.com</a>
        </dd>
      </div>
      <div>
        <dt>Numer przedsiębiorstwa/KBO (po rejestracji)</dt>
        <dd>TBD</dd>
      </div>
      <div>
        <dt>Adres siedziby w Belgii</dt>
        <dd>TBD</dd>
      </div>
      <div>
        <dt>Representatives</dt>
        <dd>
          Agnieszka Sitek-Kobosko
          <br />
          Daria Smolarek
        </dd>
      </div>
      <div>
        <dt>Policies</dt>
        <dd>Privacy Policy | Cookie Policy | Terms of Use</dd>
      </div>
    </dl>
  </div>
  <nav class="footer-nav" aria-label="Footer navigation">
    {links.map(([label, href]) => (
      <a href={href}>{label}</a>
    ))}
  </nav>
  <div class="footer-contact">
    <p>Brussels · Warsaw</p>
    <br />
    <h3>Subscribe to our newsletter</h3>
    <form class="footer-newsletter" method="post" action={NEWSLETTER_ENDPOINT}>
      <div class="footer-newsletter-row">
        <input
          type="email"
          name="email"
          required
          placeholder="Email address"
          aria-label="Email address"
        />
        <button type="submit">Subscribe</button>
      </div>
      <label class="footer-newsletter-consent">
        <input type="checkbox" name="consent" required />
        <span>
          I agree to receive emails from ESI and accept the
          <a href="/privacy">Privacy notice</a>.
        </span>
      </label>
    </form>
  </div>
  <div class="footer-base">
    <span>© 2026 The European Strategy Institute</span>
    <div class="footer-base-right">
      <span>Think Tank · European Leadership · Strategic Solutions</span>
      <div class="footer-social">
        <a
          href="https://www.linkedin.com/company/the-european-strategy-institute/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              fill="currentColor"
              d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56z"
            ></path>
          </svg>
        </a>
        <a
          href="https://www.instagram.com/theeuropeanstrategyinstitute?stkn=MWU5c3YwNThodzMyNA=="
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <rect
              x="3"
              y="3"
              width="18"
              height="18"
              rx="5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
            ></rect>
            <circle
              cx="12"
              cy="12"
              r="4.2"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
            ></circle>
            <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor"></circle>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
