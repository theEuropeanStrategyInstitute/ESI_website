---
import { Image } from "astro:assets";
import SiteFooter from "../components/layout/SiteFooter.astro";
import { SiteHeader } from "../components/layout/SiteHeader";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  pageTitle?: string;
  description?: string;
  heroImage?: ImageMetadata;
}

const { eyebrow, title, intro, pageTitle, description, heroImage } =
  Astro.props;

const stripHtml = (value: string): string => value.replace(/<[^>]*>/g, "");
const finalPageTitle =
  pageTitle || `${stripHtml(title)} — The European Strategy Institute`;
const finalDescription = stripHtml(description || intro);
---

<BaseLayout title={finalPageTitle} description={finalDescription}>
  <div class="website inner-page">
    <a class="skip" href="#main-content">
      Skip to content
    </a>
    <SiteHeader solid client:load />
    <main id="main-content">
      <header
        class="page-hero"
        class:list={{ "page-hero-with-image": heroImage }}
      >
        {heroImage && (
          <div class="page-hero-bg" aria-hidden="true">
            <Image
              src={heroImage}
              alt=""
              widths={[800, 1600, 2400]}
              sizes="100vw"
            />
          </div>
        )}
        <p class="eyebrow">{eyebrow}</p>
        <h1 set:html={title} />
        <p class="page-intro" set:html={intro} />
      </header>
      <slot />
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
