---
import SiteFooter from "../components/layout/SiteFooter.astro";
import { SiteHeader } from "../components/layout/SiteHeader";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  pageTitle?: string;
  description?: string;
  ctaLead?: string;
  ctaText?: string;
  ctaHref?: string;
}

const {
  eyebrow,
  title,
  intro,
  pageTitle,
  description,
  ctaLead,
  ctaText,
  ctaHref,
} = Astro.props;

const finalPageTitle =
  pageTitle ||
  `${title.replace(/<[^>]*>/g, "")} — The European Strategy Institute`;
const finalDescription = description || intro;
---

<BaseLayout title={finalPageTitle} description={finalDescription}>
  <div class="website inner-page">
    <a class="skip" href="#main-content">
      Skip to content
    </a>
    <SiteHeader solid client:load />
    <main id="main-content">
      <header class="page-hero">
        <p class="eyebrow">{eyebrow}</p>
        <h1 set:html={title} />
        <p class="page-intro">{intro}</p>
        {ctaText && ctaHref && (
          <div class="page-hero-cta-row">
            {ctaLead && <p class="page-hero-cta-lead">{ctaLead}</p>}
            <a class="cta page-hero-cta" href={ctaHref}>
              {ctaText} <span aria-hidden="true">→</span>
            </a>
          </div>
        )}
      </header>
      <slot />
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
