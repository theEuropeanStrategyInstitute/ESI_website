---
import { Image } from "astro:assets";
import InnerLayout from "../layouts/InnerLayout.astro";
import {
  executiveTeam,
  founders,
  board,
  type Person,
} from "../data/esi-content";

const pageTitle = "About Us | The European Strategy Institute";
const description =
  "Who ESI is, what it stands for, and why it is building its work from Brussels.";

const cardGroups: Array<{
  id: string;
  heading: string;
  intro: string;
  people: Person[];
}> = [
  {
    id: "founders",
    heading: "Founders",
    intro: "The people who founded ESI and lead its day-to-day work.",
    people: founders,
  },
  {
    id: "board",
    heading: "Board",
    intro: "Specialists who joined ESI's board.",
    people: board,
  },
];
---

<InnerLayout
  eyebrow="About us"
  title="Ideas, people, purpose — this is The European Strategy Institute"
  intro="The team behind ESI, the mission that drives us, and the sectors where we make a difference."
  pageTitle={pageTitle}
  description={description}
>
  <section class="content-section split-copy">
    <p class="section-number">01 / Who We Are</p>
    <div>
      <h2>A European Platform for Dialogue &amp; Action</h2>
      <p>Independent. Brussels-based. Designed for long-term impact.</p>
      <p>
        The European Strategy Institute (ESI) is established as an AISBL
        (Association Internationale Sans But Lucratif) under Belgian law,
        headquartered in Brussels. This structure provides the credibility,
        independence and European standing required to operate as a trusted
        policy and engagement platform at the heart of Europe.
      </p>
    </div>
  </section>

  {cardGroups.map((group) => (
    <section class="content-section expert-section" id={group.id}>
      <div class="expert-heading">
        <p class="eyebrow">{group.heading}</p>
        <p>{group.intro}</p>
      </div>
      <div class="expert-grid">
        {group.people.map((person, index) => {
          const dialogId = `${group.id}-dialog-${index}`;
          return (
            <article class="expert-card" tabindex="0">
              <div class="expert-card-photo" aria-hidden="true">
                {person.photo && (
                  <Image
                    src={person.photo}
                    alt=""
                    widths={[302, 604]}
                    sizes="(max-width: 768px) 50vw, 25vw"
                    class="expert-photo-img"
                  />
                )}
              </div>
              <div class="expert-card-info">
                <h3>{person.name}</h3>
                <div class="expert-card-role-reveal">
                  <p>{person.role}</p>
                </div>
              </div>
              <button
                type="button"
                class="expert-card-open"
                aria-haspopup="dialog"
                data-dialog-id={dialogId}
                aria-label={`Read more about ${person.name}`}
              >
                <span aria-hidden="true">+</span>
              </button>
              <dialog id={dialogId} class="expert-card-dialog">
                <button
                  type="button"
                  class="expert-card-close"
                  data-close-dialog
                  aria-label="Close"
                >
                  <span aria-hidden="true">×</span>
                </button>
                <h3>{person.name}</h3>
                <p class="expert-card-role">{person.role}</p>
                <p class="expert-card-bio">
                  {person.bio ?? "Bio coming soon."}
                </p>
              </dialog>
            </article>
          );
        })}
      </div>
    </section>
  ))}

  <section class="content-section expert-section" id="excutiveTeam">
    <div class="expert-heading">
      <p class="eyebrow">Executive team</p>
      <p>The people who lead ESI's day-to-day work.</p>
    </div>
    <div class="expert-founder-grid">
      {executiveTeam.map((person, index) => {
        const dialogId = `founders-dialog-${index}`;
        return (
          <article class="expert-founder-card">
            <div class="expert-founder-info">
              <h3>{person.name}</h3>
              <p>{person.role}</p>
              {person.email && (
                <a href={`mailto:${person.email}`}>{person.email}</a>
              )}
            </div>
            <div class="expert-founder-photo">
              {person.photo && (
                <Image
                  src={person.photo}
                  alt=""
                  widths={[302, 604]}
                  sizes="(max-width: 768px) 50vw, 25vw"
                  class="expert-photo-img"
                />
              )}
              <button
                type="button"
                class="expert-card-open"
                aria-haspopup="dialog"
                data-dialog-id={dialogId}
                aria-label={`Read more about ${person.name}`}
              >
                <span aria-hidden="true">+</span>
              </button>
            </div>
            <dialog id={dialogId} class="expert-card-dialog">
              <button
                type="button"
                class="expert-card-close"
                data-close-dialog
                aria-label="Close"
              >
                <span aria-hidden="true">×</span>
              </button>
              <h3>{person.name}</h3>
              <p class="expert-card-role">{person.role}</p>
              <p class="expert-card-bio">{person.bio ?? "Bio coming soon."}</p>
            </dialog>
          </article>
        );
      })}
    </div>
  </section>

  <section class="content-section split-copy">
    <p class="section-number">02 / Our values</p>
    <div>
      <h2>Independence, Ethics &amp; Diversity</h2>
      <p>
        The European Strategy Institute, as Brussels-based think tank — or, more
        precisely, a "do-tank" — is committed to independence, integrity,
        transparency and diversity as fundamental principles of its work.
      </p>
      <p>
        We believe that better European policy emerges when different
        perspectives, experiences, sectors and regions are meaningfully
        represented. ESI brings together voices from business, public
        institutions, academia, civil society and technology, with particular
        attention to strengthening Central and Eastern Europe's presence in
        European decision-making.
      </p>
      <strong>Independence &amp; Transparency</strong>
      <p>
        ESI retains full independence over its research, analysis, conclusions
        and recommendations. Members, partners and funders may contribute
        expertise and participate in dialogue, but they do not determine ESI's
        research outcomes or editorial content. We are transparent about our
        partnerships and significant sources of funding and responsibly manage
        potential conflicts of interest.
      </p>
      <strong>Diversity &amp; Open Dialogue</strong>
      <p>
        We value diversity of expertise, experience, geography, background and
        perspective. ESI promotes equal opportunity and an inclusive environment
        based on evidence, constructive dialogue, mutual respect and
        intellectual integrity.
      </p>
      <strong>Responsible Partnerships</strong>
      <p>
        We work with businesses, institutions and organisations that contribute
        knowledge, experience and resources to European dialogue. Financial
        support or partnership does not confer influence over ESI's conclusions,
        recommendations or publications. Our principle is simple: funding
        enables the conversation — it does not determine its outcome.
      </p>
    </div>
  </section>

  <section class="content-section split-copy">
    <p class="section-number">03 / Areas of Focus</p>
    <div>
      <p>
        The European Strategy Institute concentrates on sectors and strategic
        domains where European policy, regulation and geopolitical developments
        have a decisive impact on competitiveness, resilience and long-term
        growth.
      </p>
      <p>
        Our work focuses on the industries and technologies that will shape
        Europe's future, with particular attention to the strategic interests
        and capabilities of Central and Eastern Europe.
      </p>
      <ul>
        <li>
          <strong>Energy, Industry &amp; Industrial Transformation</strong> —
          Energy systems, energy-intensive industries, advanced manufacturing,
          chemicals, construction and industrial competitiveness.
        </li>
        <li>
          <strong>Defence, Security &amp; Strategic Resilience</strong> —
          Defence industries, security policy, dual-use technologies and
          Europe's resilience in an increasingly complex geopolitical
          environment.
        </li>
        <li>
          <strong>Critical Resources &amp; Supply Chains</strong> — Critical raw
          materials, strategic value chains, resource security and the
          foundations of Europe's industrial sovereignty.
        </li>
        <li>
          <strong>Space, Nuclear &amp; Emerging Technologies</strong> — Space
          and New Space industries, civil nuclear and SMR technologies, as well
          as emerging technologies critical to Europe's future competitiveness
          and strategic autonomy.
        </li>
      </ul>
    </div>
  </section>

  <!-- <section class="content-section split-copy">
    <p class="section-number">04 / Values</p>
    <div>
      <h2>Our values.</h2>
    </div>
  </section>

  <section class="content-section split-copy">
    <p class="section-number">05 / Why Brussels</p>
    <div>
      <h2>Why Brussels.</h2>
    </div>
  </section> -->
</InnerLayout>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;

    const opener = target.closest<HTMLElement>("[data-dialog-id]");
    if (opener) {
      const dialog = document.getElementById(opener.dataset.dialogId ?? "");
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
      return;
    }

    const closer = target.closest<HTMLElement>("[data-close-dialog]");
    if (closer) {
      closer.closest("dialog")?.close();
      return;
    }

    const dialog = target.closest("dialog");
    if (dialog && event.target === dialog) {
      // Click landed on the dialog's own padding area, i.e. the ::backdrop.
      (dialog as HTMLDialogElement).close();
    }
  });
</script>
