---
import { Image } from "astro:assets";
import InnerLayout from "../layouts/InnerLayout.astro";
import councilExpertsHero from "../assets/councilExperts_hero.png";
import { council, experts, type Person } from "../data/esi-content";

const pageTitle = "Council & Experts | The European Strategy Institute";
const description =
  "The Executive team, strategic council, and experts behind ESI's work in Brussels.";

const cardGroups: Array<{
  id: string;
  heading: string;
  intro: string;
  summary?: {
    lead: string;
    points: string[];
    closing: string;
  };
  people: Person[];
}> = [
  {
    id: "council",
    heading: "Strategic Council",
    intro:
      "The Strategic Council is an independent advisory body bringing together distinguished leaders from European institutions, business, academia, international organisations and public policy. Its purpose is to contribute strategic insight, support high-level dialogue and provide guidance on the Institute's long-term priorities.",
    summary: {
      lead: "Strategic Council members represent:",
      points: [
        "Experience at the highest levels of public and private leadership",
        "Deep understanding of European and international affairs",
        "Institutional and policy expertise",
        "Business and economic leadership",
        "Geopolitical and strategic insight",
        "Extensive cross-sector and international networks",
      ],
      closing:
        "Together, these perspectives provide ESI with a unique source of strategic insight, helping the Institute look beyond immediate policy developments and anticipate the forces shaping Europe's long-term economic and geopolitical position.",
    },
    people: council,
  },
  {
    id: "experts",
    heading: "Expert Network",
    intro:
      "ESI works with a diverse network of experts, researchers, practitioners and former policymakers who bring first-hand experience from European institutions, industry, academia and public service.",
    summary: {
      lead: "Our expert community combines:",
      points: [
        "Public policy expertise",
        "Regulatory knowledge",
        "Industry experience",
        "Strategic communications",
        "International affairs",
        "Economic and geopolitical analysis",
      ],
      closing:
        "This interdisciplinary approach allows ESI to produce practical insights and recommendations that connect strategy with implementation.",
    },
    people: experts,
  },
];
---

<InnerLayout
  eyebrow="Council & Experts"
  title="The people behind<br /><em>ESI's strategy.</em>"
  intro="Founders, strategic council, and experts bringing experience <br />from business, European institutions, academia and technology."
  pageTitle={pageTitle}
  description={description}
  heroImage={councilExpertsHero}
>
  <!-- <section class="content-section expert-section" id="executiveTeam">
    <div class="expert-heading">
      <p class="eyebrow">Executive team</p>
      <p>The people who lead ESI's day-to-day work.</p>
    </div>
    <div class="expert-founder-grid">
      {executiveTeam.map((person, index) => {
        const dialogId = `founders-dialog-${index}`;
        return (
          <article class="expert-founder-card">
            <div class="expert-founder-info">
              <h3>{person.name}</h3>
              <p>{person.role}</p>
              {person.email && (
                <a href={`mailto:${person.email}`}>{person.email}</a>
              )}
            </div>
            <div class="expert-founder-photo">
              {person.photo && (
                <Image
                  src={person.photo}
                  alt=""
                  widths={[302, 604]}
                  sizes="(max-width: 768px) 50vw, 25vw"
                  class="expert-photo-img"
                />
              )}
              <button
                type="button"
                class="expert-card-open"
                aria-haspopup="dialog"
                data-dialog-id={dialogId}
                aria-label={`Read more about ${person.name}`}
              >
                <span aria-hidden="true">+</span>
              </button>
            </div>
            <dialog id={dialogId} class="expert-card-dialog">
              <button
                type="button"
                class="expert-card-close"
                data-close-dialog
                aria-label="Close"
              >
                <span aria-hidden="true">×</span>
              </button>
              <h3>{person.name}</h3>
              <p class="expert-card-role">{person.role}</p>
              <p class="expert-card-bio">{person.bio ?? "Bio coming soon."}</p>
            </dialog>
          </article>
        );
      })}
    </div>
  </section> -->

  {cardGroups.map((group) => (
    <section class="content-section expert-section" id={group.id}>
      <div class="expert-heading">
        <p class="council-label">{group.heading}</p>
        <p>{group.intro}</p>
      </div>
      {group.summary && (
        <div class="expert-summary">
          <div class="expert-summary-points">
            <p class="expert-summary-lead eyebrow">{group.summary.lead}</p>
            <ul class="expert-summary-list">
              {group.summary.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
          <h3 class="expert-summary-closing">{group.summary.closing}</h3>
        </div>
      )}
      <div class="expert-grid">
        {group.people.map((person, index) => {
          const dialogId = `${group.id}-dialog-${index}`;
          return (
            <article class="expert-card" tabindex="0">
              <div class="expert-card-photo" aria-hidden="true">
                {person.photo && (
                  <Image
                    src={person.photo}
                    alt=""
                    widths={[302, 604]}
                    sizes="(max-width: 768px) 50vw, 25vw"
                    class="expert-photo-img"
                  />
                )}
              </div>
              <div class="expert-card-info">
                <h3>{person.name}</h3>
                <div class="expert-card-role-reveal">
                  <p>{person.role}</p>
                </div>
              </div>
              <button
                type="button"
                class="expert-card-open"
                aria-haspopup="dialog"
                data-dialog-id={dialogId}
                aria-label={`Read more about ${person.name}`}
              >
                <span aria-hidden="true">+</span>
              </button>
              <dialog id={dialogId} class="expert-card-dialog">
                <button
                  type="button"
                  class="expert-card-close"
                  data-close-dialog
                  aria-label="Close"
                >
                  <span aria-hidden="true">×</span>
                </button>
                <h3>{person.name}</h3>
                <p class="expert-card-role">{person.role}</p>
                <p class="expert-card-bio">
                  {person.bio ?? "Bio coming soon."}
                </p>
              </dialog>
            </article>
          );
        })}
      </div>
    </section>
  ))}
</InnerLayout>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;

    const opener = target.closest<HTMLElement>("[data-dialog-id]");
    if (opener) {
      const dialog = document.getElementById(opener.dataset.dialogId ?? "");
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
      return;
    }

    const closer = target.closest<HTMLElement>("[data-close-dialog]");
    if (closer) {
      closer.closest("dialog")?.close();
      return;
    }

    const dialog = target.closest("dialog");
    if (dialog && event.target === dialog) {
      // Click landed on the dialog's own padding area, i.e. the ::backdrop.
      (dialog as HTMLDialogElement).close();
    }
  });
</script>
