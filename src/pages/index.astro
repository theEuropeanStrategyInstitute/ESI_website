---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SiteHeader } from "../components/layout/SiteHeader";
import SiteFooter from "../components/layout/SiteFooter.astro";
import Eyebrow from "../components/helpers/Eyebrow.astro";
import Arrow from "../components/helpers/Arrow.astro";
import LinkButton from "../components/helpers/LinkButton.astro";
import { CouncilCarousel } from "../components/CouncilCarousel";
import {
  executiveTeam,
  council,
  influenceTools,
  sectors,
} from "../data/esi-content";
import bridgePhoto from "../assets/bridge.jpg";

const title =
  "The European Strategy Institute — Central & Eastern Europe's voice in Brussels";
const description =
  "Independent think tank and strategic platform bridging Central Europe and Brussels. Strategic insight, dialogue, and cross-border coalitions.";
---

<BaseLayout {title} {description}>
  <div class="website bridge" id="home">
    <a class="skip" href="#institute">
      Skip to content
    </a>
    <section class="bridge-opening" aria-labelledby="hero-title">
      <Image
        src={bridgePhoto}
        alt=""
        class="bridge-bg"
        width={1536}
        height={1099}
      />
      <SiteHeader client:load />
      <div class="bridge-hero">
        <Eyebrow>Central &amp; Eastern Europe ↔ Brussels</Eyebrow>
        <h1 id="hero-title">
          Empowering European Business
          <br />
          <em>Navigating for a better future</em>
        </h1>
        <LinkButton text="Discover the Institute" href="#institute" />
      </div>
      <div class="bridge-bottom">
        <span>Think Tank | European Leadership | Strategic Solutions</span>
        <a href="#institute">
          Explore our purpose <span aria-hidden="true">↓</span>
        </a>
      </div>
    </section>

    <main>
      <section class="section bridge-story" id="institute">
        <Eyebrow>Our mission</Eyebrow>
        <div>
          <h2>The missing voice of Central and Eastern Europe in Brussels.</h2>
          <p>
            The European Strategy Institute is an independent, Brussels-based
            think tank - or, more precisely, a "do-tank" - established as a
            Belgian non-profit association (ASBL).
            <br />
            <br />
            Its mission is to buildcompelling, fact-based narratives at the
            heart of Europe and to give Central and Eastern Europe a stronger,
            more professional voice in the European debate.
            <br />
            <br />
            Positioned at the centre of EU decision-making, the Institute will
            serve as a platform where policymakers, business leaders and experts
            come together to shape ideas that matter for the region’s
            competitiveness, security and long-term prosperity.
          </p>
          <a class="text-link" href="/mission">
            Read about our mission <Arrow />
          </a>
        </div>
      </section>

      <section class="bridge-pillar-wrap" aria-label="How ESI works">
        <div class="pillars">
          {[
            [
              "Insight",
              "Independent analysis, strategic reports, policy briefs and expert insights that help organisations and decision-makers understand emerging trends, regulatory developments and strategic challenges.",
            ],
            [
              "Dialogue",
              "We create opportunities for meaningful discussion through roundtables, conferences, executive forums and expert meetings in Brussels and across Europe.",
            ],
            [
              "Engagement",
              "We engage with policymakers, institutions, industry leaders and stakeholder communities to contribute expertise, facilitate dialogue and support evidence-based policymaking.",
            ],
          ].map(([number, title, body]) => (
            <article>
              <span class="index">{number}</span>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section council" id="council">
        <div class="people-intro-row">
          <Eyebrow>The people behind ESI</Eyebrow>
          <div>
            <h2 class="council-label">
              Experience. Credibility. Leadership. <br />A European perspective.
            </h2>
            <p>
              The Institute brings together experience from business, European
              institutions, academia and technology.
            </p>
          </div>
        </div>
        <div class="council-heading">
          <p class="council-label">Strategic Council</p>
          <div>
            <p>
              The Strategic Council is an independent advisory body bringing
              together distinguished leaders from European institutions,
              business, academia, international organisations and public policy.
              Its purpose is to contribute strategic insight, support high-level
              dialogue and provide guidance on the Institute's long-term
              priorities.
            </p>
          </div>
        </div>
        <CouncilCarousel council={council} client:visible />
        <a class="text-link council-cta" href="/council-experts#council">
          Meet the Council <Arrow />
        </a>
      </section>
      <section class="section work" id="work">
        <div class="section-heading">
          <Eyebrow>Publications &amp; Events</Eyebrow>
          <h2>Bringing CEE expertise to the European table.</h2>
          <br />
          <p>
            ESI connects business, policymakers and experts to bring Central and
            Eastern European experience, priorities and expertise into Europe’s
            strategic debate.
          </p>
          <a class="text-link" href="/projects">
            Explore our work <Arrow />
          </a>
        </div>
        <div class="work-list">
          {influenceTools.map((item) => (
            <details>
              <summary>
                <span class="summary-row">
                  <span class="index">{item.number}</span>
                  <span>{item.title}</span>
                  <span class="plus" aria-hidden="true">
                    +
                  </span>
                </span>
              </summary>
              <p>{item.body}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="section sector-preview">
        <div class="sector-heading">
          <Eyebrow>AREAS OF FOCUS</Eyebrow>
          <h2>
            From analysis to action - for a stronger Central and Eastern Europe.
          </h2>
        </div>
        <div class="sector-list">
          {sectors.map((sector, index) => (
            <a href="/projects#sectors">
              <span class="index">0{index + 1}</span>
              <strong>{sector.title}</strong>
              <Arrow />
            </a>
          ))}
        </div>
      </section>

      <section class="partnership-call">
        <div>
          <Eyebrow>Partnerships</Eyebrow>
          <h2>Partnerships built around ideas, shaped together</h2>
        </div>
        <div>
          <h3>
            <strong>Building Partnerships for European Impact</strong>
          </h3>
          <br />
          <p>
            ESI works with companies, institutions, universities, associations,
            foundations and public-sector organisations that share a commitment
            to strengthening Europe's future.
          </p>
          <div class="button-row">
            <LinkButton text="Partner with ESI" href="/partnership" />
          </div>
        </div>
      </section>

      <section class="content-section expert-section" id="excutiveTeam">
        <div class="expert-heading">
          <p class="council-label">Executive team</p>
          <p>
            Makes ESI's mission happen through daily engagement across Central
            and Eastern Europe.
          </p>
        </div>
        <div class="expert-founder-grid">
          {executiveTeam.map((person, index) => {
            const dialogId = `founders-dialog-${index}`;
            return (
              <article class="expert-founder-card">
                <div class="expert-founder-info">
                  <h3>{person.name}</h3>
                  <p>{person.role}</p>
                  {person.email && (
                    <a href={`mailto:${person.email}`}>{person.email}</a>
                  )}
                </div>
                <div class="expert-founder-photo">
                  {person.photo && (
                    <Image
                      src={person.photo}
                      alt=""
                      widths={[302, 604]}
                      sizes="(max-width: 768px) 50vw, 25vw"
                      class="expert-photo-img"
                    />
                  )}
                  <button
                    type="button"
                    class="expert-card-open"
                    aria-haspopup="dialog"
                    data-dialog-id={dialogId}
                    aria-label={`Read more about ${person.name}`}
                  >
                    <span aria-hidden="true">+</span>
                  </button>
                </div>
                <dialog id={dialogId} class="expert-card-dialog">
                  <button
                    type="button"
                    class="expert-card-close"
                    data-close-dialog
                    aria-label="Close"
                  >
                    <span aria-hidden="true">×</span>
                  </button>
                  <h3>{person.name}</h3>
                  <p class="expert-card-role">{person.role}</p>
                  <p class="expert-card-bio">
                    {person.bio ?? "Bio coming soon."}
                  </p>
                </dialog>
              </article>
            );
          })}
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
