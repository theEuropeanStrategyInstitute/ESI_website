---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SiteHeader } from "../components/layout/SiteHeader";
import SiteFooter from "../components/layout/SiteFooter.astro";
import Eyebrow from "../components/helpers/Eyebrow.astro";
import Arrow from "../components/helpers/Arrow.astro";
import LinkButton from "../components/helpers/LinkButton.astro";
import { CouncilCarousel } from "../components/CouncilCarousel";
import {
  council,
  founders,
  influenceTools,
  sectors,
} from "../data/esi-content";
import bridgePhoto from "../assets/bridge.jpg";

const title =
  "The European Strategy Institute — Central & Eastern Europe's voice in Brussels";
const description =
  "Independent think tank and strategic platform bridging Central Europe and Brussels. Strategic insight, dialogue, and cross-border coalitions.";
---

<BaseLayout {title} {description}>
  <div class="website bridge" id="home">
    <a class="skip" href="#institute">
      Skip to content
    </a>
    <section class="bridge-opening" aria-labelledby="hero-title">
      <Image
        src={bridgePhoto}
        alt=""
        class="bridge-bg"
        width={1536}
        height={1099}
      />
      <SiteHeader client:load />
      <div class="bridge-hero">
        <Eyebrow>Central &amp; Eastern Europe ↔ Brussels</Eyebrow>
        <h1 id="hero-title">
          Empowering European Business
          <br />
          <em>Navigating for a better future</em>
        </h1>
        <LinkButton text="Discover the Institute" href="#institute" />
      </div>
      <div class="bridge-bottom">
        <span>Think Tank | European Leadership | Strategic Solutions</span>
        <a href="#institute">
          Explore our purpose <span aria-hidden="true">↓</span>
        </a>
      </div>
    </section>

    <main>
      <section class="section bridge-story" id="institute">
        <Eyebrow>Our mission</Eyebrow>
        <div>
          <h2>The missing voice of Central and Eastern Europe in Brussels.</h2>
          <p>
            The European Strategy Institute is an independent, Brussels-based
            think tank and platform for strategic dialogue. We help European
            companies move from reacting to regulation to contributing expertise
            while policy is being shaped.
          </p>
          <a class="text-link" href="/mission">
            Read about our mission <Arrow />
          </a>
        </div>
      </section>

      <section class="bridge-pillar-wrap" aria-label="How ESI works">
        <div class="pillars">
          {[
            [
              "01",
              "Insight",
              "Independent analysis of regulatory and geopolitical change.",
            ],
            [
              "02",
              "Dialogue",
              "Trusted conversations between business and European institutions.",
            ],
            [
              "03",
              "Influence",
              "Cross-border coalitions grounded in evidence and expertise.",
            ],
          ].map(([number, title, body]) => (
            <article>
              <span class="index">{number}</span>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section work" id="work">
        <div class="section-heading">
          <Eyebrow>Programmes &amp; insights</Eyebrow>
          <h2>
            Strategic influence,
            <br />
            built over time.
          </h2>
          <p>
            ESI convenes leaders across business, finance and public
            institutions through trusted, long-term relationships.
          </p>
          <a class="text-link" href="/projects">
            Explore our work <Arrow />
          </a>
        </div>
        <div class="work-list">
          {influenceTools.map((item, index) => (
            <details open={index === 0}>
              <summary>
                <span class="summary-row">
                  <span class="index">{item.number}</span>
                  <span>{item.title}</span>
                  <span class="plus" aria-hidden="true">
                    +
                  </span>
                </span>
              </summary>
              <p>{item.body}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="section sector-preview">
        <div class="sector-heading">
          <Eyebrow>Priority sectors</Eyebrow>
          <h2>Where regulation shapes competitiveness.</h2>
        </div>
        <div class="sector-list">
          {sectors.map((sector, index) => (
            <a href="/projects#sectors">
              <span class="index">0{index + 1}</span>
              <strong>{sector.title}</strong>
              <Arrow />
            </a>
          ))}
        </div>
      </section>

      <section class="section people" id="people">
        <Eyebrow>The people behind ESI</Eyebrow>
        <div class="people-intro">
          <h2>
            Experience.
            <br />A European perspective.
          </h2>
          <p>
            The Institute brings together experience from business, European
            institutions, academia and technology.
          </p>
        </div>
        <div class="founder-grid">
          {founders.map((person) => (
            <article>
              <span class="person-kind">Founding team</span>
              <h3>{person.name}</h3>
              <p>{person.role}</p>
              <a href={`mailto:${person.email}`}>{person.email}</a>
            </article>
          ))}
        </div>
        <div class="council-heading">
          <div>
            <Eyebrow>Strategic Council</Eyebrow>
            <p>
              Independent perspectives from public life, business, academia and
              technology.
            </p>
          </div>
          <span>01—{String(council.length).padStart(2, "0")}</span>
        </div>
        <div
          class="council-strip"
          tabindex="0"
          aria-label="Strategic Council profiles"
        >
          {council.map((person, index) => (
            <article>
              <span class="index">{String(index + 1).padStart(2, "0")}</span>
              <h3>{person.name}</h3>
              <p>{person.role}</p>
            </article>
          ))}
        </div>

        <div class="council-heading">
          <div>
            <Eyebrow>Strategic Council — auto-rotating concept</Eyebrow>
            <p>
              Same profiles, animated: advances every 2 seconds and pauses on
              hover. Name stays visible; role slides up on hover to leave room
              for a photo.
            </p>
          </div>
        </div>
        <CouncilCarousel council={council} client:visible />
      </section>

      <section class="partnership-call">
        <div>
          <Eyebrow>Partnerships</Eyebrow>
          <h2>Build a credible European presence.</h2>
        </div>
        <div>
          <p>
            We work with companies, investors and institutions that have the
            ambition and capacity to operate at European scale.
          </p>
          <div class="button-row">
            <LinkButton text="Partner with ESI" href="/partnership" />
            <a class="text-link light" href="/member">
              Explore membership <Arrow />
            </a>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
