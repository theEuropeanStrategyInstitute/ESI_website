---
import InnerLayout from "../layouts/InnerLayout.astro";

const pageTitle = "Legal & Governance | The European Strategy Institute";
const description =
  "Legal entity and governance information for The European Strategy Institute.";
---

<InnerLayout
  eyebrow="Legal"
  title="Legal entity.<br /><em>Governance structure.</em>"
  intro="Everything you need to know about ESI's legal structure, governance and commitment to responsible, independent operation."
  pageTitle={pageTitle}
  description={description}
>
  <section class="content-section policy-copy">
    <p class="section-number">AISBL status + BCE/KBO number</p>
    <div>
      <h2>Numbers and statuses details to be added.</h2>
      <p class="draft-note">
        Numbers and statuses details will be published here.
      </p>
    </div>
  </section>
  <section class="content-section policy-copy">
    <p class="section-number">Articles of Association / Statutes (downloadable as PDF)</p>
    <div>
      <h2>Statuses details to be added.</h2>
      <p class="draft-note">
        Statuses details will be published here.
      </p>
    </div>
  </section>
  <section class="content-section policy-copy">
    <p class="section-number">Legal notice</p>
    <div>
      <h2>Legal notice details to be added.</h2>
      <p class="draft-note">
        Information about legal notice will be published here.
      </p>
    </div>
  </section>
  <section class="content-section policy-copy">
    <p class="section-number">Privacy Policy (GDPR)</p>
    <div>
      <h2>Privacy policy details to be added.</h2>
      <p class="draft-note">
        Privacy policy details will be
        published here.
      </p>
    </div>
  </section>
  <section class="content-section policy-copy">
    <p class="section-number">Cookie Policy</p>
    <div>
      <h2>Cookie policy details to be added.</h2>
      <p class="draft-note">
        Cookie policy details will be published here.
      </p>
    </div>
  </section>
  <section class="content-section policy-copy">
    <p class="section-number">Conflict of interest policy</p>
    <div>
      <h2>Conflict of interest details to be added.</h2>
      <p class="draft-note">
        Conflict of interest details will be published here.
      </p>
    </div>
  </section>
  <section class="content-section policy-copy">
    <p class="section-number">Funding sources information (coming soon)</p>
    <div>
      <h2>Funding sources information details to be added.</h2>
      <p class="draft-note">
        Funding sources information details will be published here.
      </p>
    </div>
  </section>
  <section class="content-section policy-copy">
    <p class="section-number">Link to EU Transparency Register entry (once available)</p>
    <div>
      <h2>EU Transparency Register information details to be added.</h2>
      <p class="draft-note">
        Link will be published here.
      </p>
    </div>
  </section>

</InnerLayout>
