---
import InnerLayout from "../layouts/InnerLayout.astro";
import { EnquiryForm } from "../components/EnquiryForm";
import { memberBenefits } from "../data/esi-content";
import membershipHero from "../assets/membership_hero.png";

const pageTitle = "Membership | The European Strategy Institute";
const description =
  "Express your interest in becoming a member of The European Strategy Institute.";
---

<InnerLayout
  eyebrow="Membership"
  title="Join a community <br />shaping Europe's future."
  intro="Become part of a trusted network of business leaders, experts and decision-makers working to strengthen Central and Eastern Europe's voice in Europe's most important policy, economic and geopolitical discussions."
  pageTitle={pageTitle}
  description={description}
  heroImage={membershipHero}
>
  <section class="content-section pub-events-section member-benefits-section why-join-section">
    <span class="pe-watermark" aria-hidden="true">
      01
    </span>
    <div class="content-heading why-join-heading">
      <div class="pe-label">
        <span class="pe-number">01</span>
        <span class="pe-rule"></span>
        <span class="pe-eyebrow">Why join</span>
      </div>
      <div class="why-join-heading-split">
        <h2>A trusted network for Europe's decision-makers</h2>
        <p class="member-benefits-intro">
          ESI membership brings together businesses, experts and institutions
          committed to building a stronger, more competitive Europe. By
          fostering collaboration, sharing strategic insights and creating
          opportunities for high-level dialogue, we help our members stay
          informed, connect with the right people and contribute to
          conversations that shape Europe's future.
        </p>
      </div>
    </div>
    <h3 class="why-join-subheading">Four ways to make a bigger impact</h3>
    <div class="pub-events-grid why-join-grid">
      {memberBenefits.map((benefit) => (
        <article class="pub-events-block why-join-card">
          <div class="why-join-media">
            <p class="why-join-number">{benefit.number}</p>
            <span class="why-join-rule"></span>
            <div class="why-join-heading-text">
              <div class="why-join-heading-copy">
                <h3>{benefit.eyebrow}</h3>
                <h4 set:html={benefit.title} />
              </div>
              <img
                class="why-join-icon"
                src={benefit.icon.src}
                alt=""
                aria-hidden="true"
                width="34"
                height="34"
              />
            </div>
          </div>
          <div class="why-join-footer">
            <ul class="plain-list benefit-points">
              {benefit.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
          <span class="why-join-stage why-join-stage-card">
            {benefit.stage}
          </span>
        </article>
      ))}
    </div>
    <div class="why-join-ribbon">
      {memberBenefits.map((benefit) => (
        <span class="why-join-stage">{benefit.stage}</span>
      ))}
    </div>
  </section>

  <section class="content-section split-copy section-dark">
    <span class="pe-watermark" aria-hidden="true">
      02
    </span>
    <div class="pe-label">
      <span class="pe-number">02</span>
      <span class="pe-rule"></span>
      <span class="pe-eyebrow">Why ESI?</span>
    </div>
    <div>
      <h2>The missing voice at the table</h2>
      <p>
        For more than two decades, Central and Eastern Europe has been one of
        Europe's strongest engines of economic growth, innovation and industrial
        development. Yet the region remains significantly under-represented in
        Brussels, where European policies and regulations are shaped.
      </p>
      <br />
      <p>
        We provide a trusted platform where business, government, academia and
        experts can engage in strategic dialogue, develop evidence-based
        solutions and contribute to shaping Europe's future economic and
        regulatory agenda.
      </p>
      <h3 class="why-join-cta">
        Join ESI. Contribute. Connect. Shape what comes next.
      </h3>
    </div>
  </section>

  <section class="content-section form-section">
    <span class="pe-watermark" aria-hidden="true">
      03
    </span>
    <div class="form-intro">
      <div class="pe-label">
        <span class="pe-number">03</span>
        <span class="pe-rule"></span>
        <span class="pe-eyebrow">Start a conversation</span>
      </div>
      <h2>Explore becoming The European Strategy Institute's member.</h2>
      <p>
        Share a few details about you and your organisation. Our team will get
        in touch to discuss the next steps.
      </p>
      <!-- <div class="form-intro-cta">
        <p class="form-intro-cta-lead">
          Looking for a one-off collaboration instead?
        </p>
        <a class="cta form-intro-cta-button" href="/partnership">
          Partner with us <span aria-hidden="true">→</span>
        </a>
      </div> -->
    </div>
    <EnquiryForm kind="membership" client:load />
  </section>
</InnerLayout>

<style>
  .why-join-media h3 {
    font-size: 36px;
    font-weight: 600;
  }
  .why-join-heading-text {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .why-join-heading-text .why-join-icon {
    margin-top: 0;
    margin-right: 10px;
  }
  .benefit-points {
    list-style: disc;
    padding-left: 18px;
  }
  .benefit-points li {
    padding-left: 4px;
  }
  .member-benefits-section .pub-events-grid {
    gap: 0;
    background: none;
    border-color: var(--line);
  }
  .member-benefits-section .pub-events-grid > .pub-events-block:nth-child(2),
  .member-benefits-section .pub-events-grid > .pub-events-block:nth-child(4) {
    background: #dfe9f2;
  }
  .member-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(2)
    .why-join-media,
  .member-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(4)
    .why-join-media {
    background: #dfe9f2;
    border-bottom-color: rgba(15, 29, 64, 0.12);
  }
  .member-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(2)
    .why-join-media::after,
  .member-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(4)
    .why-join-media::after {
    display: none;
  }
  .member-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(2)
    .why-join-icon,
  .member-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(4)
    .why-join-icon {
    filter: invert(4%) sepia(100%) saturate(5747%) hue-rotate(252deg); /* black → navy (#150958) */
  }
  .member-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(2)
    .why-join-rule,
  .member-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(4)
    .why-join-rule {
    background: var(--navy);
  }
  .member-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(2)
    .why-join-number,
  .member-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(4)
    .why-join-number,
  .member-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(2)
    .why-join-media
    h3,
  .member-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(4)
    .why-join-media
    h3,
  .member-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(2)
    .why-join-media
    h4,
  .member-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(4)
    .why-join-media
    h4 {
    color: var(--navy);
  }
  .member-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(2)
    .plain-list,
  .member-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(4)
    .plain-list {
    border-top-color: rgba(15, 29, 64, 0.12);
  }
  .member-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(2)
    .plain-list
    li,
  .member-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(4)
    .plain-list
    li {
    color: var(--navy);
    border-bottom-color: rgba(15, 29, 64, 0.12);
  }
</style>
