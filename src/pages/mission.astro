          </h3>
        </div>
      </div>
    </div>
  </section> -->

  <section class="content-section sector-preview objectives-preview-dark">
    <div class="sector-heading sector-heading--objectives">
      <Eyebrow>Strategic objectives</Eyebrow>
      <h2>Objectives that define our work</h2>
    </div>
    <div class="objective-preview-list">
      {strategicGoals.map((goal) => (
        <div class="objective-row">
          <span class="objective-bullet" aria-hidden="true"></span>
          <p>{goal}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="content-section split-copy">
    <p class="section-number">01 / The challenge</p>
    <div>
      <h2>
        CEE region helps drive Europe's growth. Its voice in Brussels remains
        limited.
      </h2>
      <p>
        Central and Eastern Europe represents more than 100 million consumers
        and is deeply integrated into European supply chains and the single
        market. Yet the region's business perspective is still underrepresented
        where European regulation takes shape.
      </p>
      <p>
        We work with local businesses, entrepreneurs, industry organisations and
        other stakeholders from CEE to better understand challenges they face
        and to bring their experience into national and European policy debates.
      </p>
      <p>
        By identifying areas where institutional support is insufficient, ESI
        seeks to provide businesses and communities with a stronger voice and
        greater access to expertise, partnerships and European-level debate
      </p>
    </div>
  </section>

  <section class="content-section evidence-section">
    <div class="evidence-heading">
      <p class="eyebrow">Brussels representation</p>
      <h2>A visible imbalance.</h2>
      <p>
        Organisations reported as maintaining a Brussels presence in the working
        research supplied to ESI.
      </p>
    </div>
    <div class="evidence-split">
      <h3 class="evidence-note">
        If Central and Eastern Europe is to play a greater role in shaping
        Europe's future, stronger and more sustained investment is needed in
        organisations that build visibility, influence and strategic engagement
        in Brussels, such as The European Strategy Institute.
      </h3>
      <div class="evidence-grid-col">
        <div class="evidence-grid">
          {representation.map(([value, label], index) => (
            <article
              class={index === representation.length - 1 ? "highlight" : ""}
            >
              <strong data-count-to={value}>0</strong>
              <span>{label}</span>
            </article>
          ))}
        </div>
        <p class="draft-note">LobbyFacts, Dec 2025.</p>
      </div>
    </div>
  </section>

  <script>
    const counters = document.querySelectorAll(
      ".evidence-grid strong[data-count-to]",
    );
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    function animateCount(el: HTMLElement) {
      const target = parseInt(el.dataset.countTo || "0", 10);
      if (prefersReducedMotion || Number.isNaN(target)) {
        el.textContent = String(target);
        return;
      }
      const duration = String(target).length >= 3 ? 2400 : 1200;
      const start = performance.now();
      function tick(now: number) {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = String(Math.round(target * eased));
        if (progress < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCount(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 },
    );

    counters.forEach((counter) => observer.observe(counter));
  </script>
  <script>
    const track = document.querySelector<HTMLElement>(".reveal-track");
    const image = document.querySelector<HTMLElement>(".reveal-image");
    const textFirst = document.querySelector<HTMLElement>(".reveal-text-first");
    const textSecond = document.querySelector<HTMLElement>(
      ".reveal-text-second",
    );

    if (track && image && textFirst && textSecond) {
      const trackEl: HTMLElement = track;
      const imageEl: HTMLElement = image;
      const textFirstEl: HTMLElement = textFirst;
      const textSecondEl: HTMLElement = textSecond;

      const mq = window.matchMedia(
        "(min-width: 900px) and (prefers-reduced-motion: no-preference)",
      );

      function clamp01(value: number): number {
        return Math.min(1, Math.max(0, value));
      }

      function reset(): void {
        imageEl.style.transform = "";
        textFirstEl.style.opacity = "";
        textFirstEl.style.transform = "";
        textSecondEl.style.opacity = "";
        textSecondEl.style.transform = "";
      }

      function update(): void {
        const rect = trackEl.getBoundingClientRect();
        const total = rect.height - window.innerHeight;
        const progress = total > 0 ? clamp01(-rect.top / total) : 0;

        imageEl.style.transform = `translateY(${60 - progress * 120}vh)`;

        const fadeOut = clamp01(1 - progress / 0.45);
        const fadeIn = clamp01((progress - 0.55) / 0.45);
        textFirstEl.style.opacity = String(fadeOut);
        textFirstEl.style.transform = `translateY(${-24 * (1 - fadeOut)}px)`;
        textSecondEl.style.opacity = String(fadeIn);
        textSecondEl.style.transform = `translateY(${24 * (1 - fadeIn)}px)`;
      }

      let ticking = false;
      function onScroll(): void {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      }

      function sync(): void {
        if (mq.matches) {
          window.addEventListener("scroll", onScroll, { passive: true });
          window.addEventListener("resize", onScroll);
          update();
        } else {
          window.removeEventListener("scroll", onScroll);
          window.removeEventListener("resize", onScroll);
          reset();
        }
      }

      mq.addEventListener("change", sync);
      sync();
    }
  </script>
  <!-- <section class="content-section objectives-section">
    <div>
      <p class="section-number">02 / Our response</p>
      <h2>From regulation-takers to regulation co-authors.</h2>
    </div>
    <ol class="objective-list">
      {strategicObjectives.map((objective, index) => (
        <li>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <p>{objective}</p>
        </li>
      ))}
    </ol>
  </section> -->

  <section class="page-cta">
    <p class="eyebrow">Take part</p>
    <h2>A balanced European dialogue needs a credible CEE voice.</h2>
    <a class="cta" href="/partnership">
      Partner with ESI <span aria-hidden="true">→</span>
    </a>
  </section>
</InnerLayout>

<style>
  :global(.page-hero .page-intro) {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(28px, 3.34vw, 45px);
    line-height: 1.2;
    max-width: 850px;
    color: white;
  }

  :global(.website .sector-heading--objectives .eyebrow) {
    font-size: 16px;
    padding-bottom: 15px;
  }
  @media (max-width: 540px) {
    :global(.website .sector-heading--objectives .eyebrow) {
      font-size: 16px;
    }
  }

  .mission-statement {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: clamp(50px, 8vw, 120px);
  }
  .mission-statement-list {
    border-top: 1px solid #c5c1d2;
  }
  .mission-statement-row {
    padding: clamp(28px, 4vw, 40px) 0;
    border-bottom: 1px solid #c5c1d2;
  }
  .mission-statement-row p {
    max-width: 700px;
    font-size: clamp(16px, 1.1vw, 18px);
    font-weight: 400;
    line-height: 1.6;
  }
  @media (max-width: 900px) {
    .mission-statement {
      grid-template-columns: 1fr;
    }
  }

  .vision-section {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: clamp(50px, 8vw, 120px);
  }
  .vision-intro {
    max-width: 480px;
    margin-top: 20px;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.35;
  }
  .vision-belief-label {
    font-size: 15px;
    font-weight: 500;
    color: #696479;
  }
  .vision-belief-list {
    margin-top: 20px;
    border-top: 1px solid #c5c1d2;
  }
  @media (max-width: 900px) {
    .vision-section {
      grid-template-columns: 1fr;
    }
  }
  .vision-belief-row {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 20px;
    align-items: center;
    min-height: 76px;
    border-bottom: 1px solid #c5c1d2;
  }
  .vision-bullet {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--navy);
  }
  .vision-belief-row p {
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 500;
  }

  .objective-preview-list .objective-row {
    grid-template-columns: 20px 1fr;
  }
  .objective-bullet {
    width: 8px;
    height: 8px;
    margin-top: 8px;
    border-radius: 50%;
    background: white;
  }

  .reveal-section {
    padding: 0;
  }
  .reveal-track {
    position: relative;
  }
  .reveal-sticky {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding: clamp(54px, 6vw, 89px) var(--space);
  }
  .reveal-text {
    display: flex;
  }
  .reveal-text h3 {
    max-width: 950px;
  }
  .reveal-text-first {
    justify-content: flex-start;
  }
  .reveal-text-first h3 {
    text-align: left;
  }
  .reveal-text-second {
    justify-content: flex-end;
  }
  .reveal-text-second h3 {
    text-align: right;
    margin-left: auto;
  }
  .reveal-image {
    height: clamp(350px, 40vw, 380px);
    border-radius: 12px;
    overflow: hidden;
  }
  .reveal-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }

  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    .reveal-track {
      height: 220vh;
    }
    .reveal-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      display: grid;
      gap: 0;
      overflow: hidden;
      padding: 0 var(--space);
    }
    .reveal-text,
    .reveal-image {
      grid-area: 1 / 1;
    }
    .reveal-text {
      align-items: center;
    }
    .reveal-image {
      align-self: center;
      position: relative;
      height: clamp(300px, 32vw, 380px);
      z-index: 2;
      will-change: transform;
    }
    .reveal-text-first {
      z-index: 1;
    }
    .reveal-text-second {
      z-index: 0;
    }
    .reveal-image :global(img) {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 200%;
      object-fit: cover;
      object-position: center bottom;
    }
  }
</style>
