---
import InnerLayout from "../layouts/InnerLayout.astro";
import Eyebrow from "../components/helpers/Eyebrow.astro";
import missionHero from "../assets/mission_hero.png";

const pageTitle = "Mission | The European Strategy Institute";
const description =
  "Why Central and Eastern European business needs a permanent, professional voice in Brussels.";

const strategicGoals: string[] = [
  "Giving Central & Eastern Europe's business community a permanent and professional voice in Brussels",
  "Transforming CEE companies from regulation-takers into regulation co-authors",
  "Providing a trusted platform through which businesses from CEE can contribute to European policy discussions and the shaping of EU regulations in strategic sectors",
];

const representation = [
  ["256", "German organisations"],
  ["152", "American organisations"],
  ["151", "French organisations"],
  ["97", "Italian organisations"],
  ["13", "Polish organisations"],
];
---

<InnerLayout
  eyebrow="Our mission"
  title="European in ambition. <br /> Brussels in presence. <br /> Central and Eastern European in perspective."
  intro=""
  pageTitle={pageTitle}
  description={description}
  heroImage={missionHero}
>
  <section class="content-section mission-statement">
    <Eyebrow>Our mission</Eyebrow>
    <div class="mission-statement-lead-wrap">
      <p class="mission-statement-lead">
        Building CEE influence in the heart of Europe.
      </p>
    </div>
    <div class="mission-statement-list">
      <div class="mission-statement-row">
        <span class="mission-statement-bullet" aria-hidden="true"></span>
        <p>
          Positioned at the centre of EU decision-making,{" "}
          <strong>the Institute serves as a platform</strong> where
          policymakers, business leaders and experts come together{" "}
          <strong>
            to shape ideas that matter for the region's competitiveness,
            security and long-term prosperity
          </strong>
        </p>
      </div>
      <div class="mission-statement-row">
        <span class="mission-statement-bullet" aria-hidden="true"></span>
        <p>
          <strong>Our ambition</strong> is not only to discuss policy, but to
          ensure that European policy responds to real economic needs -
          including those
          <strong>
            {" "}
            companies, sectors and regions that currently have none or very
            limited access to institutional support
          </strong>{" "}
          and decision-making processes
        </p>
      </div>
      <div class="mission-statement-row">
        <span class="mission-statement-bullet" aria-hidden="true"></span>
        <p>
          <strong>To strengthen the quality of European decision-making</strong>{" "}
          by connecting expertise, business and public institutions, while
          ensuring that{" "}
          <strong>
            the experience and perspective of Central and Eastern Europe
            contribute meaningfully to Europe's future
          </strong>
        </p>
      </div>
    </div>
  </section>

  <section class="content-section vision-section">
    <div class="vision-heading">
      <Eyebrow>Our vision</Eyebrow>
      <p class="vision-intro">
        We need a stronger, more competitive and resilient Europe where every
        region contributes to shaping the continent's future, and where CEE is
        recognised as a driver of innovation, economic growth and strategic
        leadership.
      </p>
    </div>
    <div class="vision-belief">
      <p class="vision-belief-label">We believe that:</p>
      <div class="vision-belief-list">
        <div class="vision-belief-row">
          <span class="vision-bullet" aria-hidden="true"></span>
          <p>Better policy begins with informed dialogue</p>
        </div>
        <div class="vision-belief-row">
          <span class="vision-bullet" aria-hidden="true"></span>
          <p>Economic competitiveness and security are inseparable</p>
        </div>
        <div class="vision-belief-row">
          <span class="vision-bullet" aria-hidden="true"></span>
          <p>European growth requires strong industrial foundations</p>
        </div>
        <div class="vision-belief-row">
          <span class="vision-bullet" aria-hidden="true"></span>
          <p>
            Strategic resilience depends on cooperation between institutions,
            business and society
          </p>
        </div>
        <div class="vision-belief-row">
          <span class="vision-bullet" aria-hidden="true"></span>
          <p>
            Central and Eastern Europe brings valuable experience, expertise and
            perspectives that enrich European decision-making
          </p>
        </div>
        <div class="vision-belief-row">
          <span class="vision-bullet" aria-hidden="true"></span>
          <p>
            Effective policy is built through collaboration, trust and
            evidence-based analysis
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section sector-preview objectives-preview-dark">
    <div class="sector-heading sector-heading--objectives">
      <Eyebrow>Strategic objectives</Eyebrow>
      <h2>The priorities that guide our mission</h2>
    </div>
    <div class="objective-preview-list">
      {strategicGoals.map((goal) => (
        <div class="objective-row">
          <span class="objective-bullet" aria-hidden="true"></span>
          <p>{goal}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="content-section split-copy">
    <span class="pe-watermark" aria-hidden="true">
      01
    </span>
    <div class="pe-label">
      <span class="pe-number">01</span>
      <span class="pe-rule"></span>
      <span class="pe-eyebrow">The challenge</span>
    </div>
    <div>
      <h2>
        CEE region helps drive Europe's growth. Its voice in Brussels remains
        limited.
      </h2>
      <p>
        Central and Eastern Europe represents more than 100 million consumers
        and is deeply integrated into European supply chains and the single
        market. Yet the region's business perspective is still underrepresented
        where European regulation takes shape.
      </p>
      <p>
        We work with local businesses, entrepreneurs, industry organisations and
        other stakeholders from CEE to better understand challenges they face
        and to bring their experience into national and European policy debates.
      </p>
      <p>
        By identifying areas where institutional support is insufficient, ESI
        seeks to provide businesses and communities with a stronger voice and
        greater access to expertise, partnerships and European-level debate
      </p>
    </div>
  </section>

  <section class="content-section evidence-section">
    <div class="evidence-heading">
      <p class="eyebrow">Brussels representation</p>
      <p>
        Organisations reported as maintaining a Brussels presence in the working
        research supplied to ESI.
      </p>
    </div>
    <div class="evidence-split">
      <div class="evidence-note-col">
        <h2 class="evidence-imbalance">A visible imbalance.</h2>
        <h3 class="evidence-note">
          If Central and Eastern Europe is to play a greater role in shaping
          Europe's future, stronger and more sustained investment is needed in
          organisations that build visibility, influence and strategic
          engagement in Brussels, such as The European Strategy Institute.
        </h3>
      </div>
      <div class="evidence-grid-col">
        <div class="evidence-grid">
          {representation.map(([value, label], index) => (
            <article
              class={index === representation.length - 1 ? "highlight" : ""}
            >
              <strong data-count-to={value}>0</strong>
              <span>{label}</span>
            </article>
          ))}
        </div>
        <p class="draft-note">LobbyFacts, Dec 2025.</p>
      </div>
    </div>
  </section>

  <script>
    const counters = document.querySelectorAll(
      ".evidence-grid strong[data-count-to]",
    );
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    function animateCount(el: HTMLElement) {
      const target = parseInt(el.dataset.countTo || "0", 10);
      if (prefersReducedMotion || Number.isNaN(target)) {
        el.textContent = String(target);
        return;
      }
      const duration = String(target).length >= 3 ? 2400 : 1200;
      const start = performance.now();
      function tick(now: number) {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = String(Math.round(target * eased));
        if (progress < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCount(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 },
    );

    counters.forEach((counter) => observer.observe(counter));
  </script>
  <section class="page-cta">
    <p class="eyebrow">Take part</p>
    <h2>A balanced European dialogue needs a credible CEE voice.</h2>
    <a class="cta" href="/member">
      Become a member <span aria-hidden="true">→</span>
    </a>
  </section>
</InnerLayout>

<style>
  :global(.page-hero .page-intro) {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(28px, 3.34vw, 45px);
    line-height: 1.2;
    max-width: 850px;
    color: white;
  }

  :global(.website .sector-heading--objectives .eyebrow) {
    font-family: var(--serif);
    font-size: clamp(44px, 4.4vw, 60px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: none;
    color: inherit;
    padding-bottom: 15px;
  }

  .sector-heading--objectives h2 {
    font-family: var(--serif);
    font-size: 30px;
  }

  .mission-statement {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    column-gap: clamp(50px, 8vw, 120px);
    row-gap: 0;
  }
  .mission-statement > :global(.eyebrow) {
    grid-column: 1 / -1;
  }
  .mission-statement-lead-wrap {
    display: flex;
    align-items: center;
    height: 100%;
  }
  .mission-statement-lead {
    font-size: 60px;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .mission-statement-list {
    border-top: 1px solid #c5c1d2;
  }
  .mission-statement-row {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 20px;
    align-items: flex-start;
    padding: clamp(28px, 4vw, 40px) 0;
    border-bottom: 1px solid #c5c1d2;
  }
  .mission-statement-bullet {
    width: 8px;
    height: 8px;
    margin-top: 8px;
    border-radius: 50%;
    background: var(--navy);
  }
  .mission-statement-row p {
    max-width: 700px;
    font-size: clamp(16px, 1.1vw, 18px);
    font-weight: 400;
    line-height: 1.6;
  }
  @media (max-width: 900px) {
    .mission-statement {
      grid-template-columns: 1fr;
    }
  }

  .vision-section {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: clamp(50px, 8vw, 120px);
  }
  .vision-intro {
    max-width: 480px;
    margin-top: 40px;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(32px, 3.3vw, 38px);
    line-height: 1.35;
  }
  .vision-belief-label {
    font-size: 18px;
    font-weight: 500;
    color: var(--navy);
  }
  .vision-belief-list {
    margin-top: 20px;
    border-top: 1px solid #c5c1d2;
  }
  @media (max-width: 900px) {
    .vision-section {
      grid-template-columns: 1fr;
    }
  }
  .vision-belief-row {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 20px;
    align-items: center;
    min-height: 76px;
    padding: 8px 0;
    border-bottom: 1px solid #c5c1d2;
  }
  .vision-bullet {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--navy);
  }
  .vision-belief-row p {
    font-family: var(--sans);
    font-size: clamp(16px, 1.5vw, 18px);
    font-weight: 400;
    line-height: 1.7;
  }

  .objective-preview-list .objective-row {
    grid-template-columns: 20px 1fr;
  }
  .objective-bullet {
    width: 8px;
    height: 8px;
    margin-top: 8px;
    border-radius: 50%;
    background: white;
  }
</style>
