---
import InnerLayout from "../layouts/InnerLayout.astro";
import Eyebrow from "../components/helpers/Eyebrow.astro";
import { EnquiryForm } from "../components/EnquiryForm";

const pageTitle = "Partnerships | The European Strategy Institute";
const description =
  "Partner with ESI to strengthen business participation in European policymaking.";
---

<InnerLayout
  eyebrow="Partnerships"
  title="Building Partnerships for European Impact"
  intro="ESI works with companies, institutions, universities, associations, foundations and public-sector organisations that share a commitment to strengthening Europe's future."
  pageTitle={pageTitle}
  description={description}
  ctaLead="Want to be part of the ESI community?"
  ctaText="Become a Member"
  ctaHref="/member"
>
  <section
    class="content-section partnership-principles"
    aria-label="Our partnerships"
  >
    <Eyebrow>Our partnerships are built on three principles</Eyebrow>
    <div class="pillars">
      {[
        [
          "Independence",
          "We maintain the highest standards of intellectual integrity and analytical independence.",
        ],
        [
          "Expertise",
          "We connect partners with leading experts and strategic insights.",
        ],
        [
          "Impact",
          "We focus on creating tangible value through dialogue, engagement and informed decision-making.",
        ],
      ].map(([title, body]) => (
        <article>
          <span class="index">{title}</span>
          <h3>{body}</h3>
        </article>
      ))}
    </div>
    <h3 class="partnership-principles-tagline">
      European in ambition. Brussels in presence. Central and Eastern European
      in perspective.
    </h3>
  </section>

  <section class="content-section form-section">
    <div class="form-intro">
      <p class="section-number">02 / Start a conversation</p>
      <h2>Tell us where your European priorities are taking you.</h2>
      <p>
        You can also contact us directly at{" "}
        <a href="mailto:partnerships@esi-eu.com">partnerships@esi-eu.com</a>.
      </p>
    </div>
    <EnquiryForm kind="partnership" client:load />
  </section>
</InnerLayout>

<style>
  .partnership-principles {
    background: var(--paper);
  }
  .partnership-principles :global(.eyebrow) {
    margin-bottom: clamp(28px, 4vw, 40px);
    color: var(--muted-foreground);
  }
  .partnership-principles .pillars article {
    border-top-color: var(--line);
    transition:
      border-color 180ms ease,
      transform 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .partnership-principles .pillars article:hover {
    border-color: var(--navy);
    transform: translateY(-3px);
  }
  .partnership-principles .pillars h3 {
    color: var(--navy);
  }
  .partnership-principles .pillars .index {
    color: var(--muted-foreground);
  }
  .partnership-principles-tagline {
    margin-top: clamp(24px, 3.5vw, 44px);
    padding-top: clamp(36px, 5vw, 56px);
    border-top: 1px solid var(--line);
    max-width: 850px;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(26px, 3.2vw, 40px);
    line-height: 1.3;
    text-align: left;
    color: var(--navy);
  }
</style>
