---
import InnerLayout from "../layouts/InnerLayout.astro";
import { EnquiryForm } from "../components/EnquiryForm";
import { partnershipBenefits } from "../data/esi-content";
import partnershipHero from "../assets/partnership_hero.png";

const pageTitle = "Partnerships | The European Strategy Institute";
const description =
  "Partner with ESI to strengthen business participation in European policymaking.";
---

<InnerLayout
  eyebrow="Partnerships"
  title="Building Partnerships <br />for European Impact"
  intro="ESI works with companies, institutions, universities, associations, foundations and public-sector organisations that share <br />a commitment to strengthening Europe's future."
  pageTitle={pageTitle}
  description={description}
  heroImage={partnershipHero}
>
  <section class="content-section pub-events-section why-join-section partnership-benefits-section">
    <span class="pe-watermark" aria-hidden="true">
      01
    </span>
    <div class="content-heading why-join-heading">
      <div class="pe-label">
        <span class="pe-number">01</span>
        <span class="pe-rule"></span>
        <span class="pe-eyebrow">How to partner</span>
      </div>
      <div class="why-join-heading-split">
        <h2>Partnerships built around shared goals.</h2>
        <p class="member-benefits-intro">
          ESI partners with organisations that want to engage more deeply in the
          issues shaping Europe's future. Together, we develop initiatives that
          combine expertise, research, dialogue and cross-sector collaboration.
        </p>
      </div>
    </div>
    <h3 class="why-join-subheading">As an ESI Partner, you can:</h3>
    <div class="pub-events-grid why-join-grid">
      {partnershipBenefits.map((benefit) => (
        <article class="pub-events-block why-join-card">
          <div class="why-join-media">
            <p class="why-join-number">{benefit.number}</p>
            <span class="why-join-rule"></span>
            <h3>{benefit.title}</h3>
          </div>
          <div class="why-join-footer">
            <img
              class="why-join-icon"
              src={benefit.icon.src}
              alt=""
              aria-hidden="true"
              width="28"
              height="28"
            />
            <p>{benefit.body}</p>
          </div>
        </article>
      ))}
    </div>
    <div class="why-join-ribbon">
      {partnershipBenefits.map((benefit) => (
        <span class="why-join-stage">{benefit.stage}</span>
      ))}
    </div>
  </section>

  <section
    class="content-section partnership-principles section-dark"
    aria-label="Our partnerships"
  >
    <p class="council-label">Our partnerships are built on three principles</p>
    <div class="pillars">
      {[
        [
          "Independence",
          "We maintain the highest standards of intellectual integrity and analytical independence",
        ],
        [
          "Expertise",
          "We connect partners with leading experts and strategic insights",
        ],
        [
          "Impact",
          "We focus on creating tangible value through dialogue, engagement and informed decision-making",
        ],
      ].map(([title, body]) => (
        <article>
          <span class="index">{title}</span>
          <h3>{body}</h3>
        </article>
      ))}
    </div>
  </section>

  <section class="content-section form-section">
    <span class="pe-watermark" aria-hidden="true">
      02
    </span>
    <div class="form-intro">
      <div class="pe-label">
        <span class="pe-number">02</span>
        <span class="pe-rule"></span>
        <span class="pe-eyebrow">Start a conversation</span>
      </div>
      <h2>Tell us where your European priorities are taking you.</h2>
      <p>
        You can also contact us directly at{" "}
        <a href="mailto:partnerships@esi-eu.com">partnerships@esi-eu.com</a>.
      </p>
      <!-- <div class="form-intro-cta">
        <p class="form-intro-cta-lead">Want to be part of the ESI community?</p>
        <a class="cta form-intro-cta-button" href="/member">
          Become a Member <span aria-hidden="true">→</span>
        </a>
      </div> -->
    </div>
    <EnquiryForm kind="partnership" client:load />
  </section>
</InnerLayout>

<style>
  .partnership-benefits-section .pub-events-grid {
    gap: 0;
    background: none;
    border-color: var(--line);
  }
  .partnership-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(2),
  .partnership-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(4) {
    background: #dfe9f2;
  }
  .partnership-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(2)
    .why-join-media,
  .partnership-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(4)
    .why-join-media {
    background: #dfe9f2;
    border-bottom-color: rgba(15, 29, 64, 0.12);
  }
  .partnership-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(2)
    .why-join-media::after,
  .partnership-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(4)
    .why-join-media::after {
    display: none;
  }
  .partnership-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(2)
    .why-join-icon,
  .partnership-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(4)
    .why-join-icon {
    filter: none;
  }
  .partnership-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(2)
    .why-join-rule,
  .partnership-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(4)
    .why-join-rule {
    background: var(--navy);
  }
  .partnership-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(2)
    .why-join-number,
  .partnership-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(4)
    .why-join-number,
  .partnership-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(2)
    .why-join-media
    h3,
  .partnership-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(4)
    .why-join-media
    h3 {
    color: var(--navy);
  }
  .partnership-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(2)
    .why-join-footer
    > p,
  .partnership-benefits-section
    .pub-events-grid
    > .pub-events-block:nth-child(4)
    .why-join-footer
    > p {
    color: #51607a;
  }
  .partnership-principles :global(.eyebrow) {
    margin-bottom: clamp(28px, 4vw, 40px);
    color: #d8d4e8;
  }
  .partnership-principles .pillars article {
    border-top-color: rgba(255, 255, 255, 0.2);
    transition:
      border-color 180ms ease,
      transform 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .partnership-principles .pillars article:hover {
    border-color: white;
    transform: translateY(-3px);
  }
  .partnership-principles .pillars h3 {
    color: white;
  }
  .partnership-principles .pillars .index {
    color: #d8d4e8;
  }
  .partnership-tagline-section {
    display: flex;
    justify-content: flex-start;
  }
  .partnership-principles-tagline {
    max-width: 950px;
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(32px, 4.4vw, 56px);
    line-height: 1.2;
    text-align: left;
    color: white;
  }
</style>
