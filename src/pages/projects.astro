---
import { getCollection } from "astro:content";
import InnerLayout from "../layouts/InnerLayout.astro";
import { influenceTools, sectors } from "../data/esi-content";
import publicationsEventsHero from "../assets/publicationsEvents_hero.png";
import Arrow from "../components/helpers/Arrow.astro";
import EntryDialog from "../components/helpers/EntryDialog.astro";
// import programmes from "../data/esi-programmes";

const pageTitle = "Programmes & Insights | The European Strategy Institute";
const description =
  "ESI programmes, strategic influence tools and priority sectors.";

const formatDate = (date: Date): string =>
  date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });

const now = new Date();
const startOfToday = Date.UTC(
  now.getUTCFullYear(),
  now.getUTCMonth(),
  now.getUTCDate(),
);

// Next scheduled event; if none is upcoming, the most recent past one.
const events = (await getCollection("events")).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime(),
);
const latestEvent =
  events.find((event) => event.data.date.getTime() > startOfToday) ??
  events.at(-1);
const latestEventData = latestEvent?.data;
const latestEventMeta =
  latestEventData &&
  [
    formatDate(latestEventData.date),
    latestEventData.time,
    latestEventData.format,
  ]
    .filter(Boolean)
    .join(" · ");
const latestEventRegister = latestEventData?.registrationUrl
  ? ({
      label: "Register",
      href: latestEventData.registrationUrl,
      external: true,
    } as const)
  : undefined;

const latestPublication = (await getCollection("publications")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)[0];
const latestPublicationData = latestPublication?.data;
const latestPublicationMeta =
  latestPublicationData &&
  [formatDate(latestPublicationData.date), latestPublicationData.category]
    .filter(Boolean)
    .join(" · ");
const latestPublicationPdf = latestPublicationData?.pdf
  ? ({
      label: "Read publication (PDF)",
      href: latestPublicationData.pdf,
      external: true,
    } as const)
  : undefined;
---

<InnerLayout
  eyebrow="PUBLICATIONS & EVENTS"
  title="Ideas that move Europe Forward."
  intro="ESI connects leaders from business, finance and public institutions across Central and Eastern Europe with policymakers in Brussels."
  pageTitle={pageTitle}
  description={description}
  heroImage={publicationsEventsHero}
>
  <section class="content-section tools-section">
    <span class="pe-watermark" aria-hidden="true">
      01
    </span>
    <div class="content-heading">
      <div class="pe-label">
        <span class="pe-number">01</span>
        <span class="pe-rule"></span>
        <span class="pe-eyebrow">How we work</span>
      </div>
      <h2>
        Local insight. <br />
        European impact.
      </h2>
      <p>
        The Institute works with local businesses, entrepreneurs, industry
        organisations and other stakeholders across Central and Eastern Europe
        to understand the challenges they face and bring their experience into
        national and European policy debates.
        <br />
        <br />
        Our goal is to give the region a voice in Brussels that matches its
        economic and geopolitical weight - through a strategic dialogue platform
        at the intersection of business, policy and European institutions.
      </p>
    </div>
    <div class="tool-grid">
      {influenceTools.map((tool) => (
        <article>
          <h3>
            {tool.title === "Executive round tables" ? (
              <>
                Executive
                <br />
                round tables
              </>
            ) : (
              tool.title
            )}
          </h3>
          <p>{tool.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="content-section sectors-section" id="sectors">
    <span class="pe-watermark" aria-hidden="true">
      02
    </span>
    <div class="content-heading">
      <div class="pe-label">
        <span class="pe-number">02</span>
        <span class="pe-rule"></span>
        <span class="pe-eyebrow">Areas of Focus</span>
      </div>
      <h2>Where European rules have a direct impact on competitiveness.</h2>
    </div>
    <div class="sector-detail-list">
      {sectors.map((sector, index) => (
        <article>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{sector.title}</h3>
          <p>{sector.topics}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- <section class="content-section programmes-section">
    <div class="content-heading">
      <p class="section-number">03 / Flagship programmes</p>
      <h2>Two forums for Europe's defining questions.</h2>
    </div>
    <div class="programme-grid">
      {programmes.map((programme) => (
        <article>
          <span>{programme.number}</span>
          <h3>{programme.title}</h3>
          <p>{programme.body}</p>
          <small>{programme.note}</small>
        </article>
      ))}
    </div>
  </section> -->

  <section class="content-section section-dark pe-split" id="publications">
    <div class="pe-col pe-col-left pe-col-dark">
      <span class="pe-watermark" aria-hidden="true">
        03
      </span>
      <div class="pe-label">
        <span class="pe-number">03</span>
        <span class="pe-rule"></span>
        <span class="pe-eyebrow">Publications</span>
      </div>
      <h2 class="pe-heading">What Europe needs to know.</h2>
    </div>
    <div class="pe-col pe-col-right pe-col-dark">
      <p class="pe-copy">
        ESI publishes strategic reports, policy briefs, expert commentaries and
        analytical papers addressing the key issues shaping Europe's future.
        <br />
        <br /> Our publications are designed to support decision-makers,
        business leaders and institutions with rigorous analysis and actionable
        insights.
      </p>
      <button
        type="button"
        class="cta pe-cta"
        data-dialog-open="latest-publication-dialog"
        aria-haspopup="dialog"
      >
        Explore <Arrow />
      </button>
    </div>
  </section>

  <section class="content-section pe-split" id="events">
    <div class="pe-col pe-col-left pe-col-dark">
      <span class="pe-watermark" aria-hidden="true">
        04
      </span>
      <div class="pe-label">
        <span class="pe-number">04</span>
        <span class="pe-rule"></span>
        <span class="pe-eyebrow">Events</span>
      </div>
      <h2 class="pe-heading">Where Europe's conversations take place.</h2>
    </div>
    <div class="pe-col pe-col-right pe-col-light">
      <p class="pe-copy">
        ESI brings together policymakers, business leaders, academics and
        experts through executive roundtables, policy dialogues, strategic
        forums, closed-door expert discussions, public conferences and bilateral
        stakeholder meetings.
      </p>
      <button
        type="button"
        class="cta pe-cta"
        data-dialog-open="latest-event-dialog"
        aria-haspopup="dialog"
      >
        Take a look <Arrow />
      </button>
    </div>
  </section>

  <EntryDialog
    id="latest-publication-dialog"
    eyebrow="Latest publication"
    emptyMessage="No publications have been released yet. Please check back soon."
    title={latestPublicationData?.title}
    meta={latestPublicationMeta}
    summary={latestPublicationData?.summary}
    image={latestPublicationData?.image}
    primaryLink={latestPublicationPdf}
    allLink={{ label: "All publications", href: "/publications" }}
  />

  <EntryDialog
    id="latest-event-dialog"
    eyebrow="Latest event"
    emptyMessage="No events have been announced yet. Please check back soon."
    title={latestEventData?.title}
    meta={latestEventMeta}
    location={latestEventData?.location}
    summary={latestEventData?.summary}
    image={latestEventData?.image}
    primaryLink={latestEventRegister}
    allLink={{ label: "All events", href: "/events" }}
  />

  <section class="page-cta">
    <p class="eyebrow">Work with us</p>
    <h2>Bring your sector expertise into the European conversation.</h2>
    <a class="cta" href="/partnership">
      Discuss a partnership <span aria-hidden="true">→</span>
    </a>
  </section>
</InnerLayout>

<style>
  button.pe-cta {
    border: 0;
    cursor: pointer;
    font-family: inherit;
    letter-spacing: inherit;
  }
</style>
